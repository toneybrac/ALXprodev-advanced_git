#!/bin/bash

# pre-commit hook: Checks if each directory has a README file
# Usage: Place in .git/hooks/pre-commit and make executable

echo "🚀 Running pre-commit hook: Checking for README files..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "⚠️ No files staged for commit. Skipping README check."
    exit 0
fi

# Get unique directories from staged files
DIRECTORIES=$(echo "$STAGED_FILES" | xargs -I {} dirname {} | sort -u)

MISSING_README=false

for DIR in $DIRECTORIES; do
    # Skip root directory
    if [ "$DIR" = "." ]; then
        continue
    fi
    
    # Check if directory has a README file
    README_FOUND=false
    
    # Check for various README file extensions
    for EXT in "" ".md" ".txt" ".rst"; do
        if [ -f "$DIR/README$EXT" ] || [ -f "$DIR/readme$EXT" ] || [ -f "$DIR/Readme$EXT" ]; then
            README_FOUND=true
            break
        fi
    done
    
    if [ "$README_FOUND" = false ]; then
        echo "❌ Directory '$DIR' doesn't have a README file!"
        echo "   Please add README.md to describe the directory contents."
        MISSING_README=true
    else
        echo "✅ Directory '$DIR' has a README file"
    fi
done

if [ "$MISSING_README" = true ]; then
    echo ""
    echo "📝 Some directories are missing README files."
    echo "   You can:"
    echo "   1. Add README files to missing directories"
    echo "   2. Skip this check with: git commit --no-verify"
    echo "   3. Force commit anyway (not recommended)"
    echo ""
    read -p "Do you want to continue with commit anyway? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "❌ Commit aborted. Please add README files."
        exit 1
    fi
fi

echo "✅ Pre-commit check passed!"
exit 0
